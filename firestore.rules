rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['superAdmin'])
        && request.auth.token.superAdmin == true;
    }

    function belongsToCompany(companyId) {
      return signedIn()
        && !isSuperAdmin()
        && request.auth.token.keys().hasAny(['tenantId'])
        && request.auth.token.tenantId == companyId;
    }

    match /companies/{companyId} {
      allow get, list: if isSuperAdmin() || belongsToCompany(companyId);
      allow create, update, delete: if false;

      match /{document=**} {
        allow read, write: if belongsToCompany(companyId);
      }
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
